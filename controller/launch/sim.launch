<launch>
  <arg name="bt_tree_path" default="$(find controller)/config/mav.xml"/>
  <arg name="bt_log_file" default="/tmp/srdrone-BTlog.txt"/>
  <rosparam command="load" file="$(find controller)/config/sim.yaml"/>
  <node pkg="controller" name="controller" type="controller_node" output="screen">
    <param name="bt_tree_path" value="$(arg bt_tree_path)"/>
    <param name="bt_log_file" value="$(arg bt_log_file)"/>
  </node>
</launch>
